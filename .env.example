# ── Django settings ──────────────────────────────────────
# Note: copy this file to .env at the project root.
# Django now loads .env automatically at startup.
# Generate a real key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,votre-domaine.com

# PostgreSQL
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=compta_matieres
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=change-me
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
